<?xml version="1.0" encoding="utf-8"?>
<!--
    The -v26 qualifier stays even though minSdk is 30 and lint calls it
    obsolete: dropping it makes aapt2 stop producing an unversioned
    mipmap/ic_launcher at all, and the build fails with "resource
    mipmap/ic_launcher not found". The qualifier is what tells aapt2 which
    version bucket to key the adaptive icon and its monochrome layer to.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <!-- Themed icons tint a silhouette, so this layer is the mark's alpha over
         black rather than the two-colour artwork. -->
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
