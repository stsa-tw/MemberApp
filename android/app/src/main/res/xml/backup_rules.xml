<?xml version="1.0" encoding="utf-8"?>
<!--
    The pre-Android-12 half of data_extraction_rules.xml.

    android:allowBackup="false" already stops backup on these versions, so this
    changes nothing on its own — it is here so the intent is stated in both
    places rather than depending on which attribute a given release reads.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
