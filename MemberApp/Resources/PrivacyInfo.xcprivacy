<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Required since 2024 for apps using "required reason" APIs. Without it
	     App Store Connect rejects the upload. AppAuth ships its own manifest;
	     this one covers the app target. -->

	<key>NSPrivacyTracking</key>
	<false/>

	<key>NSPrivacyTrackingDomains</key>
	<array/>

	<!-- Nothing is transmitted off the device to us or to a third party. The
	     profile arrives from the member's own STSA account and stays local;
	     the membership code is requested from STSA's own API. Apple counts
	     only data sent off-device as collected. -->
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>

	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<!-- AppSettings (appearance, card lock) and the cached profile,
			     keyed on sub. Credentials are in the Keychain, not here. -->
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<!-- CA92.1: access info from the app itself, same app only. -->
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
