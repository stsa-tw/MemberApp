{
  // Hover popups
  "editor.hover.enabled": true,
  "editor.hover.delay": 300,
  "editor.hover.sticky": true,
  "editor.parameterHints.enabled": true,

  // Swift / sourcekit-lsp. Symbol info comes from Xcode's index store via
  // buildServer.json (generated by xcode-build-server), so background
  // indexing stays off — it only applies to SwiftPM packages.
  "swift.sourcekit-lsp.backgroundIndexing": "off",
  "sourcekit-lsp.inlayHints.enabled": true,
  "[swift]": {
    "editor.inlayHints.enabled": "onUnlessPressed"
  }
}
